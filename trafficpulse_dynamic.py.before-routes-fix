    </output>

    <random_number>
        <seed value="{SEED}"/>
    </random_number>

</configuration>
"""

    config_file.write_text(
        sumocfg
    )

    # --------------------------------------------------------
    # Print scenario.
    # --------------------------------------------------------

    print()
    print("=" * 80)
    print("DYNAMIC DEMAND")
    print("=" * 80)

    print(
        f"Observed timestamp:     "
        f"{timestamp}"
    )

    print(
        f"Predicted total before "
        f"calibration:           "
        f"{predicted_total:.2f}"
    )

    print(
        f"Vehicles to SUMO:       "
        f"{actual_sim_total}"
    )

    print()

    for direction in (
        "N",
        "S",
        "E",
        "W",
    ):

        detail = source_details[direction]

        print(
            f"{direction}: "
            f"site={detail['site']} "
            f"{detail['heading']} | "
            f"current="
            f"{detail['current_observed_total']:.1f} | "
            f"prediction="
            f"{detail['model_prediction']:.1f} | "
            f"source_forecast="
            f"{detail['model_prediction']:.1f} | "
            f"SUMO="
            f"{direction_integer[direction]}"
        )

    print()
    print("Vehicle composition:")

    for vehicle_type, share in (
        composition.items()
    ):
        print(
            f"  {vehicle_type:<12}"
            f"{share * 100:6.2f}%"
        )

    print()
    print("Generated:")
    print(
        f"  Route:  {route_file}"
    )
    print(
        f"  Config: {config_file}"
    )

    if args.no_run:
        print()
        print(
            "Simulation not started "
            "(--no-run)."
        )
        return

    # --------------------------------------------------------
    # Run SUMO.
    # --------------------------------------------------------

    executable = (
        SUMO_GUI_BIN
        if args.gui
        else SUMO_BIN
    )

    if not executable.exists():
        raise FileNotFoundError(
            f"SUMO executable missing: {executable}"
        )

    if tripinfo_file.exists():
        tripinfo_file.unlink()

    env = os.environ.copy()

    if args.gui:
        env["LIBGL_ALWAYS_SOFTWARE"] = "1"

    command = [
        str(executable),
        "-c",
        str(config_file.resolve()),
    ]

    print()
    print("=" * 80)

    if args.gui:
        print("STARTING SUMO-GUI")
    else:
        print("STARTING HEADLESS SUMO")

    print("=" * 80)

    print(
        " ".join(command)
    )

    subprocess.run(
        command,
        check=True,
        env=env,
    )

    # --------------------------------------------------------
    # Metrics.
    # --------------------------------------------------------

    metrics = calculate_metrics(
        tripinfo_file
    )

    result = {
        "timestamp": str(timestamp),

        "model": "XGBoost",

        "reference_total": REFERENCE_TOTAL,

        "predicted_total_before_calibration": (
            predicted_total
        ),

        "simulated_total": (
            actual_sim_total
        ),

        "direction_integer": (
            direction_integer
        ),

