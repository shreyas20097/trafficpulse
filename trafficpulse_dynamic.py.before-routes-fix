            "Generate the SUMO scenario but do not "
            "launch SUMO."
        ),
    )

    parser.add_argument(
        "--tag",
        default=None,
        help=(
            "Optional output name, "
            "otherwise timestamp is used."
        ),
    )

    args = parser.parse_args()

    validate_environment()

    try:
        timestamp = pd.Timestamp(
            f"{args.date} {args.time}"
        )
    except Exception as exc:
        raise ValueError(
            "Invalid --date/--time combination."
        ) from exc

    if timestamp.minute not in (0, 15, 30, 45):
        raise ValueError(
            "TIRTL timestamps must be 15-minute aligned."
        )

    print("=" * 80)
    print("TRAFFICPULSE DYNAMIC PREDICTION")
    print("=" * 80)

    print(
        f"Prediction timestamp: {timestamp}"
    )
    print(
        "Target: next 15-minute "
        "motorized demand"
    )

    # --------------------------------------------------------
    # Load model
    # --------------------------------------------------------

    print("\nLoading XGBoost model...")

    model = joblib.load(
        MODEL_FILE
    )

    # Inference here is only four rows, so CPU inference is
    # faster/simpler than transferring tiny inputs to CUDA.
    model.set_params(device="cpu")

    print(
        f"Model features: "
        f"{len(model.feature_names_in_)}"
    )

    # --------------------------------------------------------
    # Load only the columns required for inference.
    # --------------------------------------------------------

    print("Loading TIRTL features...")

    df = pd.read_csv(
        FEATURE_FILE,
        parse_dates=["datetime"],
        low_memory=False,
    )

    df["site"] = pd.to_numeric(
        df["site"],
        errors="coerce",
    )

    df["heading"] = df["heading"].astype(str)

    # --------------------------------------------------------
    # Generate four directional predictions.
    # --------------------------------------------------------

    predictions = {}
    source_details = {}

    for direction, (
        site,
        heading,
    ) in SOURCE_STREAMS.items():

        rows = find_previous_required_row(
            df,
            site,
            heading,
            timestamp,
        )

        if len(rows) != 1:

            raise RuntimeError(
                f"Expected exactly one row for "
                f"{direction}: "
                f"site={site}, "
                f"heading={heading}, "
                f"time={timestamp}, "
                f"found {len(rows)}"
            )

        row = rows.iloc[0]

        x = make_model_input(
            row,
            model,
        )

        prediction = float(
            model.predict(x)[0]
        )

        # Demand cannot physically be negative.
        prediction = max(
            0.0,
            prediction,
        )

        predictions[direction] = prediction

        source_details[direction] = {
            "site": int(site),
            "heading": heading,
            "current_observed_total": float(
                row["total_motorized"]
            ),
            "model_prediction": prediction,
            "target_next_15min_actual_available_in_data": (
                float(row["target_next_15min"])
                if not pd.isna(
                    row["target_next_15min"]
                )
                else None
            ),
        }

    # --------------------------------------------------------
    # Calibrate each real directional stream to the
    # representative hypothetical intersection.
    #
    # We preserve each stream's temporal prediction but
    # normalize its magnitude so the reference period gives
    # our 1050-vehicle representative baseline.
    # --------------------------------------------------------

    # Correct demand calibration:
    # TIRTL source streams are independent sensors, not the four
    # arms of one physical intersection. Use them only to derive
    # the short-term XGBoost multiplier, and use the representative
    # TIRTL profile for the hypothetical intersection demand scale.
    profile = pd.read_csv(PROFILE_FILE)
    profile["hour"] = profile["hour"].astype(int)
    profile["time_bin"] = profile["time_bin"].astype(str)

    profile_row = profile[
        (profile["hour"] == int(timestamp.hour))
        & (profile["time_bin"] == str(args.time))
    ]

    if profile_row.empty:
        raise ValueError(
            f"No representative TIRTL profile row for "
            f"hour={timestamp.hour}, time_bin={args.time}"
        )

    representative_current = float(
        profile_row.iloc[0]["mean_demand"]
    )

    current_source_total = sum(
        float(source_details[d]["current_observed_total"])
        for d in SOURCE_STREAMS
    )

    predicted_source_total = sum(
        float(source_details[d]["model_prediction"])
        for d in SOURCE_STREAMS
    )

    if current_source_total <= 0:
        raise ValueError(
            "Current TIRTL source total is zero; "
            "cannot calculate forecast multiplier."
        )

    forecast_multiplier = (
        predicted_source_total / current_source_total
    )

    forecast_multiplier = max(
        0.50,
        min(1.50, forecast_multiplier)
    )

    dynamic_total = max(
        1,
        int(round(
            representative_current * forecast_multiplier
        ))
    )

    direction_integer = exact_allocate(
        dynamic_total,
        DIRECTION_SHARE
    )

    actual_sim_total = sum(direction_integer.values())

    # Output tag used for the generated SUMO files.
    tag = (
        args.tag
        if args.tag
        else timestamp.strftime("%Y%m%d_%H%M")
    )

    print()
    print("Demand calibration:")
    print(f"  Representative profile : {representative_current:.2f} veh/15min")
    print(f"  Current source total   : {current_source_total:.2f}")
    print(f"  Predicted source total : {predicted_source_total:.2f}")
    print(f"  XGBoost multiplier     : {forecast_multiplier:.4f}")
    print(f"  Dynamic intersection   : {dynamic_total} veh/15min")
    print(f"  N/S/E/W                : {direction_integer}")
    print(f"  Simulation total       : {actual_sim_total} veh/15min")

    route_file = (
        DEMAND_DIR
        / f"{tag}.rou.xml"
    )

    config_file = (
        BASE
        / f"{tag}.sumocfg"
    )

    tripinfo_file = (
        OUTPUT_DIR
        / f"{tag}.tripinfo.xml"
    )

    results_file = (
        OUTPUT_DIR
        / f"{tag}.results.json"
    )

    route_file.write_text(
        routes_xml
    )

    # --------------------------------------------------------
    # SUMO configuration.
    # --------------------------------------------------------

    sumocfg = f"""<configuration>

    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="demand/{route_file.name}"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="{SIM_END}"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="300"/>
    </processing>

    <output>
        <tripinfo-output value="output/{tripinfo_file.name}"/>
