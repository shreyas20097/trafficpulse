    parser = argparse.ArgumentParser(
        description=(
            "TrafficPulse dynamic "
            "XGBoost → SUMO controller"
        )
    )

    parser.add_argument(
        "--date",
        required=True,
        help="YYYY-MM-DD",
    )

    parser.add_argument(
        "--time",
        required=True,
        help="HH:MM, e.g. 17:00",
    )

    parser.add_argument(
        "--gui",
        action="store_true",
        help="Open SUMO-GUI instead of headless SUMO.",
    )

    parser.add_argument(
        "--no-run",
        action="store_true",
