def validate_environment():

    required = [
        FEATURE_FILE,
        MODEL_FILE,
        COMPOSITION_FILE,
        PROFILE_FILE,
        SUMO_BIN,
        NETWORK,
    ]

    missing = [
        str(path)
        for path in required
        if not path.exists()
    ]

    if missing:
        raise FileNotFoundError(
            "Missing required files:\n"
            + "\n".join(missing)
        )


