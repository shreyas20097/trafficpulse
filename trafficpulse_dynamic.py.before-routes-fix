        "source_streams": (
            source_details
        ),

        "vehicle_composition": (
            composition
        ),

        "turn_share": (
            TURN_SHARE
        ),

        "metrics": metrics,

        "route_file": str(
            route_file
        ),

        "config_file": str(
            config_file
        ),

        "tripinfo_file": str(
            tripinfo_file
        ),
    }

    results_file.write_text(
        json.dumps(
            result,
            indent=2,
        )
    )

    print()
    print("=" * 80)
    print("DYNAMIC TRAFFICPULSE RESULTS")
    print("=" * 80)

    for key, value in metrics.items():
        print(
            f"{key:<30} {value}"
        )

    print()
    print(
        f"Results: {results_file}"
    )


