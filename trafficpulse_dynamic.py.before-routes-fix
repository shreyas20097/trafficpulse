def exact_allocate(
    total: int,
    shares: dict[str, float],
) -> dict[str, int]:
    """
    Integer allocation that always sums exactly to total.
    Uses the largest-remainder method.
    """

    keys = list(shares)

    raw = {
        key: total * shares[key]
        for key in keys
    }

    values = {
        key: math.floor(raw[key])
        for key in keys
    }

    remaining = total - sum(values.values())

    order = sorted(
        keys,
        key=lambda key: (
            raw[key] - values[key]
        ),
        reverse=True,
    )

    for key in order[:remaining]:
        values[key] += 1

    return values


def find_previous_required_row(
    df: pd.DataFrame,
    site: int,
    heading: str,
    timestamp: pd.Timestamp,
) -> pd.DataFrame:

    subset = df[
        (df["site"] == site)
        & (df["heading"] == heading)
        & (df["datetime"] == timestamp)
    ]

    return subset


def make_model_input(
    row: pd.Series,
    model,
) -> pd.DataFrame:
    """
    Recreate the exact feature representation used during
    training.

    Training:
        numeric features
        + site
        + heading
        -> pd.get_dummies(...)
        -> float32

    The saved XGBoost model contains feature_names_in_,
    so we align to that exact schema.
    """

    numeric_features = [
        "bicycle",
        "error",
        "heavy_articulated",
        "motorcycle",
        "rigid_truck_bus",
        "short_vehicle",
        "short_vehicle_towing",
        "unknown",

        "mean_speed",
        "total_motorized",
        "total_all",

        "hour",
        "minute",
        "day_of_week",
        "is_weekend",
        "time_sin",
        "time_cos",

        "lag_1",
        "lag_2",
        "lag_4",
        "lag_8",

        "rolling_mean_4",
        "rolling_std_4",
        "rolling_mean_8",
        "rolling_std_8",

        "motorcycle_share",
        "short_vehicle_share",
        "short_vehicle_towing_share",
        "rigid_truck_bus_share",
        "heavy_articulated_share",
    ]

    categorical_features = [
        "site",
        "heading",
    ]

    values = {}

    for column in numeric_features:
        value = row[column]

        if pd.isna(value) or not np.isfinite(float(value)):
            value = 0.0

        values[column] = float(value)

    values["site"] = str(int(row["site"]))
    values["heading"] = str(row["heading"])

    x = pd.DataFrame(
        [values]
    )

    x = pd.get_dummies(
        x,
        columns=categorical_features,
        dtype=np.float32,
    )

    expected_features = list(
        model.feature_names_in_
    )

    x = x.reindex(
        columns=expected_features,
        fill_value=0,
    )

    return x.astype(np.float32)


def load_vehicle_composition(
    hour: int,
) -> dict[str, float]:
    """
    Read the hourly composition generated during the TIRTL
    composition audit.
    """

    if not COMPOSITION_FILE.exists():
        raise FileNotFoundError(
            f"Missing composition file: {COMPOSITION_FILE}"
        )

    df = pd.read_csv(
        COMPOSITION_FILE,
        index_col=0,
    )

    if hour not in df.index:
        # CSV indices may have been read as strings.
        df.index = df.index.astype(int)

    if hour not in df.index:
        raise ValueError(
            f"No vehicle composition for hour {hour}"
        )

    row = df.loc[hour]

    composition = {}

    for source_column, sumo_type in SUMO_VEHICLE_TYPES.items():

        share_column = f"{source_column}_share"

        if share_column not in row.index:
            raise RuntimeError(
                f"Missing {share_column} "
                f"in {COMPOSITION_FILE}"
            )

        composition[sumo_type] = float(
            row[share_column]
        )

    total = sum(composition.values())

    if total <= 0:
        raise RuntimeError(
            "Vehicle composition sums to zero."
        )

    # Normalize to avoid tiny floating-point differences.
    composition = {
        key: value / total
        for key, value in composition.items()
    }

    return composition


def parse_tripinfo(
    path: Path,
) -> tuple[list[dict], list[dict]]:

    if not path.exists():
        raise RuntimeError(
            f"SUMO did not create TripInfo: {path}"
        )

    root = ET.parse(path).getroot()

    finished = []
    unfinished = []

    for element in root.findall("tripinfo"):

        arrival = float(
            element.attrib.get(
                "arrival",
                "-1",
            )
        )

        duration = float(
            element.attrib.get(
                "duration",
                "-1",
            )
        )

        record = {
            "id": element.attrib.get("id"),
            "depart": float(
                element.attrib.get(
                    "depart",
                    "nan",
                )
            ),
            "arrival": arrival,
            "duration": duration,
            "waitingTime": float(
                element.attrib.get(
                    "waitingTime",
                    "nan",
                )
            ),
            "timeLoss": float(
                element.attrib.get(
                    "timeLoss",
                    "nan",
                )
            ),
            "routeLength": float(
                element.attrib.get(
                    "routeLength",
                    "nan",
                )
            ),
            "vtype": element.attrib.get(
                "vtype",
                "",
            ),
        }

        if arrival >= 0 and duration >= 0:
            finished.append(record)
        else:
            unfinished.append(record)

    return finished, unfinished


def calculate_metrics(
    tripinfo: Path,
) -> dict:

    finished, unfinished = parse_tripinfo(
        tripinfo
    )

    all_trips = finished + unfinished

    durations = [
        x["duration"]
        for x in finished
        if np.isfinite(x["duration"])
    ]

    waiting = [
        x["waitingTime"]
        for x in finished
        if np.isfinite(x["waitingTime"])
    ]

    time_loss = [
        x["timeLoss"]
        for x in finished
        if np.isfinite(x["timeLoss"])
    ]

    total = len(all_trips)
    arrived = len(finished)

    return {
        "vehicles_reported": total,
        "vehicles_arrived": arrived,
        "vehicles_unfinished": len(unfinished),
        "completion_rate_pct": (
            arrived / total * 100
            if total
            else 0
        ),
        "mean_travel_time_s": (
            float(np.mean(durations))
            if durations
            else 0
        ),
        "mean_waiting_time_s": (
            float(np.mean(waiting))
            if waiting
            else 0
        ),
        "mean_time_loss_s": (
            float(np.mean(time_loss))
            if time_loss
            else 0
        ),
    }


