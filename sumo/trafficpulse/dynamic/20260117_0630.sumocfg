<configuration>

    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="demand/20260117_0630.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="300"/>
    </processing>

    <output>
        <tripinfo-output value="output/20260117_0630.tripinfo.xml"/>
        <tripinfo-output.write-unfinished value="true"/>
    </output>

    <random_number>
        <seed value="42"/>
    </random_number>

</configuration>
