<configuration>
    <input>
        <net-file value="../network/intersection.net.xml"/>
        <route-files value="../demand/test.rou.xml"/>
    </input>

    <time>
        <begin value="0"/>
        <end value="300"/>
        <step-length value="1"/>
    </time>

    <processing>
        <time-to-teleport value="300"/>
    </processing>

    <report>
        <verbose value="true"/>
        <no-step-log value="false"/>
    </report>
</configuration>
